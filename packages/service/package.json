{
  "name": "@momos/service",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pkgroll --clean-dist",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "exports": {
    "import": {
      "types": "./dist/AppType.d.ts",
      "default": "./dist/AppType.js"
    },
    "require": {
      "types": "./dist/AppType.d.cts",
      "default": "./dist/AppType.cjs"
    }
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "hono": "^4.12.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "pkgroll": "^2.27.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.75.0"
  }
}
