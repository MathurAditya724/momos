{
  "name": "@momos/inspector",
  "productName": "Momos",
  "description": "MCP inspector for debugging and inspecting MCP servers.",
  "version": "0.2.0",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "type": "module",
  "bin": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "sandbox",
    "inspector",
    "debugging",
    "debugger",
    "tools",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev --entry ./dist-electron/main/index.js",
    "build": "vite build --mode client && vite build",
    "build:electron": "electron-vite build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "homepage": "https://github.com/rhinobase/momos",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinobase/momos.git",
    "directory": "packages/inspector"
  },
  "bugs": {
    "url": "https://github.com/rhinobase/momos/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/main.d.ts",
        "default": "./dist/client/main.js"
      },
      "require": {
        "types": "./dist/client/main.d.cts",
        "default": "./dist/client/main.cjs"
      }
    }
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.25.1",
    "@momos/service": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.8.2",
    "electron-vite": "^4.0.1",
    "rollup-plugin-sourcemaps2": "^0.5.6",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/standard-validator": "^0.2.2",
    "@libsql/client": "^0.17.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@tanstack/react-query": "^5.90.21",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "nuqs": "^2.8.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  }
}
